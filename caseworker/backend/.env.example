CASEWORKER_MODEL=gemini-3.7-flash
CASEWORKER_REPOSITORY=memory
CASEWORKER_FIRESTORE_COLLECTION=caseworker_cases
CASEWORKER_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Set both values in Cloud Run to require and verify Pub/Sub OIDC pushes.
# CASEWORKER_PUBSUB_AUDIENCE=https://caseworker-xxxxx.run.app
# CASEWORKER_PUBSUB_SERVICE_ACCOUNT=caseworker-pubsub-push@your-project-id.iam.gserviceaccount.com
